<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mapper.AqyAlarmEquipmentMapper">
    
    <resultMap type="AqyAlarmEquipment" id="AqyAlarmEquipmentResult">
        <result property="id"    column="id"    />
        <result property="projectId"    column="project_id"    />
        <result property="eqmtName"    column="eqmt_name"    />
        <result property="eqmtCode"    column="eqmt_code"    />
        <result property="onlineStatus"    column="online_status"    />
        <result property="alarmTime"    column="alarm_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="createUid"    column="create_uid"    />
        <result property="isDelete"    column="is_delete"    />
        <result property="longitude"    column="longitude"    />
        <result property="latitude"    column="latitude"    />
    </resultMap>

    <sql id="selectAqyAlarmEquipmentVo">
        select id, project_id, eqmt_name, eqmt_code, online_status,alarm_time,
               create_time, create_uid, is_delete, longitude, latitude
        from aqy_alarm_equipment
    </sql>

    <select id="selectAqyAlarmEquipmentList" parameterType="AqyAlarmEquipment" resultMap="AqyAlarmEquipmentResult">
        <include refid="selectAqyAlarmEquipmentVo"/>
        <where>  
            <if test="projectId != null "> and project_id = #{projectId}</if>
            <if test="eqmtName != null  and eqmtName != ''"> and eqmt_name like concat('%', #{eqmtName}, '%')</if>
            <if test="eqmtCode != null  and eqmtCode != ''"> and eqmt_code = #{eqmtCode}</if>
            <if test="onlineStatus != null "> and online_status = #{onlineStatus}</if>
            <if test="createUid != null "> and create_uid = #{createUid}</if>
            <if test="isDelete != null "> and is_delete = #{isDelete}</if>
        </where>
    </select>
    
    <select id="selectAqyAlarmEquipmentById" parameterType="Long" resultMap="AqyAlarmEquipmentResult">
        <include refid="selectAqyAlarmEquipmentVo"/>
        where id = #{id}
    </select>

    <insert id="insertAqyAlarmEquipment" parameterType="AqyAlarmEquipment" useGeneratedKeys="true" keyProperty="id">
        insert into aqy_alarm_equipment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="eqmtName != null">eqmt_name,</if>
            <if test="eqmtCode != null">eqmt_code,</if>
            <if test="onlineStatus != null">online_status,</if>
            <if test="alarmTime != null">alarm_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createUid != null">create_uid,</if>
            <if test="isDelete != null">is_delete,</if>
            <if test="longitude != null">longitude,</if>
            <if test="latitude != null">latitude,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="eqmtName != null">#{eqmtName},</if>
            <if test="eqmtCode != null">#{eqmtCode},</if>
            <if test="onlineStatus != null">#{onlineStatus},</if>
            <if test="alarmTime != null">#{alarmTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createUid != null">#{createUid},</if>
            <if test="isDelete != null">#{isDelete},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="latitude != null">#{latitude},</if>
         </trim>
    </insert>

    <update id="updateAqyAlarmEquipment" parameterType="AqyAlarmEquipment">
        update aqy_alarm_equipment
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="eqmtName != null">eqmt_name = #{eqmtName},</if>
            <if test="eqmtCode != null">eqmt_code = #{eqmtCode},</if>
            <if test="onlineStatus != null">online_status = #{onlineStatus},</if>
            <if test="alarmTime != null">alarm_time = #{alarmTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createUid != null">create_uid = #{createUid},</if>
            <if test="isDelete != null">is_delete = #{isDelete},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAqyAlarmEquipmentById" parameterType="Long">
        delete from aqy_alarm_equipment where id = #{id}
    </delete>

    <delete id="deleteAqyAlarmEquipmentByIds" parameterType="String">
        delete from aqy_alarm_equipment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>