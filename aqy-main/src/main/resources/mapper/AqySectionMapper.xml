<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mapper.AqySectionMapper">
    
    <resultMap type="AqySection" id="AqySectionResult">
        <result property="id"    column="id"    />
        <result property="projectId"    column="project_id"    />
        <result property="sectionName"    column="section_name"    />
        <result property="longitude"    column="longitude"    />
        <result property="latitude"    column="latitude"    />
        <result property="createTime"    column="create_time"    />
        <result property="createUid"    column="create_uid"    />
        <result property="isDelete"    column="is_delete"    />
        <collection property="children" column="id"
                    select="com.ruoyi.mapper.AqySectionEqmtMapper.selectAqySectionEqmtListBySectionId"/>
    </resultMap>

    <sql id="selectAqySectionVo">
        select id, project_id, section_name, longitude, latitude, create_time, create_uid, is_delete from aqy_section
    </sql>

    <select id="selectAqySectionList" parameterType="AqySection" resultMap="AqySectionResult">
        <include refid="selectAqySectionVo"/>
        <where>  
            <if test="projectId != null "> and project_id = #{projectId}</if>
            <if test="sectionName != null  and sectionName != ''"> and section_name like concat('%', #{sectionName}, '%')</if>
            <if test="longitude != null "> and longitude = #{longitude}</if>
            <if test="latitude != null "> and latitude = #{latitude}</if>
            <if test="createUid != null "> and create_uid = #{createUid}</if>
            <if test="isDelete != null "> and is_delete = #{isDelete}</if>
        </where>
    </select>
    
    <select id="selectAqySectionById" parameterType="Long" resultMap="AqySectionResult">
        <include refid="selectAqySectionVo"/>
        where id = #{id}
    </select>

    <insert id="insertAqySection" parameterType="AqySection" useGeneratedKeys="true" keyProperty="id">
        insert into aqy_section
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="sectionName != null">section_name,</if>
            <if test="longitude != null">longitude,</if>
            <if test="latitude != null">latitude,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createUid != null">create_uid,</if>
            <if test="isDelete != null">is_delete,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="sectionName != null">#{sectionName},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="latitude != null">#{latitude},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createUid != null">#{createUid},</if>
            <if test="isDelete != null">#{isDelete},</if>
         </trim>
    </insert>

    <update id="updateAqySection" parameterType="AqySection">
        update aqy_section
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="sectionName != null">section_name = #{sectionName},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createUid != null">create_uid = #{createUid},</if>
            <if test="isDelete != null">is_delete = #{isDelete},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAqySectionById" parameterType="Long">
        delete from aqy_section where id = #{id}
    </delete>

    <delete id="deleteAqySectionByIds" parameterType="String">
        delete from aqy_section where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>