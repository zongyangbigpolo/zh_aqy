<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mapper.AqyEquipmentFileMapper">

    <resultMap type="AqyEquipmentFile" id="AqyEquipmentFileResult">
        <result property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="eqmtId" column="eqmt_id"/>
        <result property="fileName" column="file_name"/>
        <result property="fileUrl" column="file_url"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectAqyEquipmentFileVo">
        select id, project_id, eqmt_id, file_name, file_url, create_time
        from aqy_equipment_file
    </sql>

    <select id="selectAqyEquipmentFileList" parameterType="AqyEquipmentFile" resultMap="AqyEquipmentFileResult">
        <include refid="selectAqyEquipmentFileVo"/>
        <where>
            <if test="projectId != null ">and project_id = #{projectId}</if>
            <if test="eqmtId != null ">and eqmt_id = #{eqmtId}</if>
            <if test="fileName != null  and fileName != ''">and file_name = #{fileName}</if>
            <if test="fileUrl != null  and fileUrl != ''">and file_url = #{fileUrl}</if>
        </where>
    </select>

    <select id="selectAqyEquipmentFileById" parameterType="Long" resultMap="AqyEquipmentFileResult">
        <include refid="selectAqyEquipmentFileVo"/>
        where id = #{id}
    </select>

    <select id="selectAqyEquipmentFileByEqmtId" parameterType="Long" resultMap="AqyEquipmentFileResult">
        <include refid="selectAqyEquipmentFileVo"/>
        where eqmt_id = #{eqmtId}
    </select>

    <insert id="insertAqyEquipmentFile" parameterType="AqyEquipmentFile">
        insert into aqy_equipment_file
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="projectId != null">project_id,</if>
            <if test="eqmtId != null">eqmt_id,</if>
            <if test="fileName != null">file_name,</if>
            <if test="fileUrl != null">file_url,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="eqmtId != null">#{eqmtId},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="fileUrl != null">#{fileUrl},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateAqyEquipmentFile" parameterType="AqyEquipmentFile">
        update aqy_equipment_file
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="eqmtId != null">eqmt_id = #{eqmtId},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="fileUrl != null">file_url = #{fileUrl},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAqyEquipmentFileById" parameterType="Long">
        delete
        from aqy_equipment_file
        where id = #{id}
    </delete>

    <delete id="deleteAqyEquipmentFileByIds" parameterType="String">
        delete from aqy_equipment_file where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>