    </sql>

    <select id="selectAqyHikWyList" parameterType="AqyHikWy" resultMap="AqyHikWyResult">
        <include refid="selectAqyHikWyVo"/>
        <where>  
            <if test="deviceAddr != null  and deviceAddr != ''"> and device_addr = #{deviceAddr}</if>
            <if test="valueWyX != null  and valueWyX != ''"> and value_wy_x = #{valueWyX}</if>
            <if test="valueWyY != null  and valueWyY != ''"> and value_wy_y = #{valueWyY}</if>
            <if test="valueWyZ != null  and valueWyZ != ''"> and value_wy_z = #{valueWyZ}</if>
            <if test="catchTime != null "> and catch_time = #{catchTime}</if>
            <if test="createUid != null "> and create_uid = #{createUid}</if>
        </where>
        order by catch_time DESC
    </select>
    
    <select id="selectAqyHikWyById" parameterType="Long" resultMap="AqyHikWyResult">
        <include refid="selectAqyHikWyVo"/>
