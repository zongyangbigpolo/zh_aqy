            <if test="valueWyX != null">value_wy_x,</if>
            <if test="valueWyY != null">value_wy_y,</if>
            <if test="valueWyZ != null">value_wy_z,</if>
            <if test="catchTime != null">catch_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createUid != null">create_uid,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceAddr != null">#{deviceAddr},</if>
            <if test="valueWyX != null">#{valueWyX},</if>
            <if test="valueWyY != null">#{valueWyY},</if>
            <if test="valueWyZ != null">#{valueWyZ},</if>
            <if test="catchTime != null">#{catchTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createUid != null">#{createUid},</if>
         </trim>
    </insert>

    <update id="updateAqyHikWy" parameterType="AqyHikWy">
        update aqy_hik_wy
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceAddr != null">device_addr = #{deviceAddr},</if>
            <if test="valueWyX != null">value_wy_x = #{valueWyX},</if>
            <if test="valueWyY != null">value_wy_y = #{valueWyY},</if>
            <if test="valueWyZ != null">value_wy_z = #{valueWyZ},</if>
            <if test="catchTime != null">catch_time = #{catchTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createUid != null">create_uid = #{createUid},</if>
        </trim>
