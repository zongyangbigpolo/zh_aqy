<mapper namespace="com.ruoyi.mapper.AqyHikWyMapper">
    
    <resultMap type="AqyHikWy" id="AqyHikWyResult">
        <result property="id"    column="id"    />
        <result property="deviceAddr"    column="device_addr"    />
        <result property="valueWyX"    column="value_wy_x"    />
        <result property="valueWyY"    column="value_wy_y"    />
        <result property="valueWyZ"    column="value_wy_z"    />
